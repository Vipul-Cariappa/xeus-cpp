{
  "display_name": "C11",
  "argv": [
      "@XEUS_CPP_KERNELSPEC_PATH@xcpp",
      "-f",
      "{connection_file}",
      "-resource-dir", "@XEUS_CPP_RESOURCE_DIR@","-xc",
      "-I", "@XEUS_CPP_INCLUDE_DIR@",
      "-I@XEUS_CPP_INCLUDE_DIR@/python3.12/",
      "-std=c11"@XEUS_CPP_OMP@
  ],
  "language": "c",
  "kernel_protocol_version": "5.6.0", 
  "metadata": {"debugger": false
  }
}
