{
  "display_name": "C++23 CUDA",
  "argv": [
      "@XEUS_CPP_KERNELSPEC_PATH@xcpp",
      "-f",
      "{connection_file}",
      "-resource-dir", "@XEUS_CPP_RESOURCE_DIR@",
      "-I", "@XEUS_CPP_INCLUDE_DIR@",
      "-I@XEUS_CPP_INCLUDE_DIR@/python3.12/",
      "-std=c++23", "-stdlib=libc++",
      "-I@XEUS_CPP_INCLUDE_DIR@/../targets/x86_64-linux/include/",
      "--cuda"
  ],
  "language": "cpp",
  "kernel_protocol_version": "5.6.0", 
  "metadata": {"debugger": false
  }
}
